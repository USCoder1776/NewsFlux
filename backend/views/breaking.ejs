<!DOCTYPE html>
<html>
<head>
  <title>Breaking News</title>
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"  rel="stylesheet" >
  <link rel="stylesheet" href="/css/breaking.css">
</head>
<body>


  <nav class="navbar  sticky-top" style="background-color: #b80000;" data-bs-theme="light" >
  <div class=" container-fluid ">
    <a href="/"><button style="text-decoration: solid;"  class="btn btn-dark mt-0 " >Back to Home</button></a>
<h1>Breaking News</h1>
 <form class="d-flex" role="search"   action="/search" method="GET">
        <input  name="query" class=" form-control me-2" type="search" placeholder="Search" aria-label="Search"   required/>
        <button class="btn btn-success" type="submit">Search</button>
      </form>

<a  href="add" class="btn btn-dark cat mt-1 ">Add News</a>

</div>

</nav> 

<hr class="line">
<!-- <a href="/"><button style="text-decoration: solid;"  class="btn btn-danger  mt-2 ms-2">Back to Home</button></a>
 <a  href="add" class="btn btn-danger cat  mt-2">Add News</a> <hr> -->


<div class="container-fluid mt-1 px-2">
  <div class="row">
    <div  class="col-2 max-auto" id="nmn" style="background-color: rgb(227, 193, 211);">

     

    </div>
       

    
     




    <div class="col-8 max-auto  tbar">

      <% news.forEach(item => { %>

        <div class="mb-3 p-2 border border-dark border-3 rounded shadow-sm   tbaro">

          <img src="<%= item.image %>" class="img-fluid w-100">

          <h3><%= item.title %></h3>
          <p><%= item.description %></p>

          <a href="<%= item.url %>" target="_blank" class="btn btn-primary mt-3">
            Read More
          </a>

          <hr>
          <p><b>Time:</b> <%= item.publishedAt %></p>

        </div>

      <% }) %>

    </div>

   <div class="col-2 max-auto" id="nmn" style="background-color: rgb(224, 252, 149);">
     <!-- <img src="antique-colored-paper-background-texture-dark-old-distressed-vintage-design-colour-green-photo-162265125.webp" class="img-fluid w-100"> -->




     </div>








</div>
  </div>

</body>
</html>