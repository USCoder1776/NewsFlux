<!DOCTYPE html>
<html>
<head>
  <title>Category</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/category.css">
</head>
<body>


 <nav class="navbar  sticky-top" style="background-color: #b80000;" data-bs-theme="light">
  <div class="container-fluid ">
    <a href="/"><button id="n"  style="text-decoration: solid;"  class="btn btn-dark  mt-0">Back to Home</button></a>
     
<h1> <%= category.charAt(0).toUpperCase() + category.slice(1) %></h1>
<form class="d-flex" role="search"  action="/search" method="GET">
        <input class="form-control me-2" type="search" placeholder="Search" name="query"  aria-label="Search"   required/>
        <button class="btn btn-success" type="submit">Search</button>
      </form>

</div>
</nav> 






<!-- <h2>Category: <%= category %></h2> -->

<!-- <a href="/"><button id="n"  style="text-decoration: solid;"  class="btn btn-dark  mt-2 ms-2">Back to Home</button></a> -->

<hr class="line">

<% if (news.length === 0) { %>
  <p>No news available</p>
<% } %>

<div class="container-fluid mt-1 px-2">

  <div class="row">

    <!-- LEFT -->
    <div class="col-2 max-auto" id="nmn" style="background-color: rgb(224,252,149);">
    </div>

    <!-- CENTER -->
    <div class="col-8 mx-auto  tbar">

      <% news.forEach(item => { %>

        <% if(item.category ===category) { %>

          <div class="mb-3 p-2 border border-dark border-3 rounded shadow-sm  tbaro">

            <img src="<%= item.image %>" class="img-fluid w-100">

            <h3><%= item.title %></h3>

            <p><%= item.description %></p>

            <a href="<%= item.url %>" 
               target="_blank" 
               class="btn btn-primary mt-3">
              Read More
            </a>

            <hr>

          </div>

        <% } %>

      <% }) %>

    </div>

    <!-- RIGHT -->
    <div class="col-2  max-auto" id="nmn" style="background-color: rgb(227,193,211);">
    </div>

  </div>

</div>


</body>
</html>