<!DOCTYPE html>
<html>
<head>
  <title>NewsFlux</title> 
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
 
<nav class="navbar navbar-expand-lg navbar-dark  px-3 sticky-top">

  <a class="navbar-brand d-flex align-items-center me-0" href="/">
    <img src="ChatGPT Image May 3, 2026, 07_28_22 PM.png" style="height:40px;">
  </a>
  <span class="navbar-brand ms-2 mt-1 h1">NewsFlux</span>
   <h9 style="font-size:xx-large;">Main</h9>

  <div class="ms-auto d-flex gap-2">
    <a href="/" class="btn btn-light">Home</a>
    <a href="/breaking" class="btn btn-light">Breaking</a>
    <a href="/category/tech" class="btn btn-light">Tech</a>
    <a href="/category/sports" class="btn btn-light">Sports</a>
    <a href="/add" class="btn btn-light">Add News</a>
  </div>

   </nav>

<hr class="line">

<!-- <h2 id="l">Home</h2> -->

<% if (news.length === 0) { %>
  <p>No news yet</p>
<% } %>

<div class="container-fluid mt-1 px-2">
  <div class="row">

    <!-- LEFT -->
   <div class="col-md-3">
     <% news.slice(1,5).forEach(item => { %>
     <div class="mb-3 p-2 border border-dark border-3 rounded shadow-sm">
      <img src="<%= item.image %>" class="img-fluid mb-2">
     <h6>
        <!-- <a href="<%= item.url %>" target="_blank" class="text-dark text-decoration-none"> </a>-->
          <%= item.title %>
        
      </h6>
    <a href="<%= item.url %>" target="_blank" class="btn btn-primary mt-3 ">
        Read More
      </a>
    </div>
  <% }) %>
</div>



    <!-- CENTER -->
    <div class="col-md-6">
       <% if(news[0]) { %>
  <div class="p-3 border border-3 border-dark rounded shadow-sm">
    <img src="<%= news[0].image %>" class=" img-fluid w-100">
   <h3 class="fw-bold">
        <!-- <a href="<%= news[0].url %>" target="_blank" class="text-dark text-decoration-none"></a> -->
          <%= news[0].title %>
        
      </h3>
    <p class="text-muted">
        <%= news[0].description %>
      </p>
    <a href="<%= news[0].url %>" target="_blank" class="btn btn-primary mt-2">
        Read More
      </a>
    </div>
     <% } %>
       </div>



    <!-- RIGHT -->
  <div class="col-md-3">
    <% news.slice(5,9).forEach(item => { %>
     <div class="mb-3 p-2 border border-3 border-dark  rounded shadow-sm">
       <img src="<%= item.image %>" class="img-fluid mb-2">
     <h6> <%= item.title %> </h6> 
        
      <a href="<%= item.url %>" target="_blank" class="btn btn-primary mt-2">
        Read More
      </a>
    </div>
<% }) %>
</div>

  

</div>
</div>

</body>
</html>