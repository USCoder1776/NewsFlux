<!DOCTYPE html>
<html>
<head>
  <title>Search</title>
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/search.css">
</head>
<body>


<nav class="navbar  sticky-top" style="background-color: #b80000;" data-bs-theme="light" >
  <div class=" container-fluid ">
    <a href="/"><button style="text-decoration: solid;"  class="btn btn-dark mt-0 " >Back to Home</button></a>
<h1>Search Results</h1>
</div>

</nav> 




 <hr class="line">


<% if(news.length === 0) { %>
  <h3>No News Found</h3>
<% } %>


 


<div class="container-fluid mt-1 px-2">
  <div class="row">

    <div  class="col-2 max-auto" id="nmn" style="background-color: rgb(227, 193, 211);">
    </div>



<div class="col-8 max-auto  tbar">
    <% news.forEach(item => { %>
  <div class="mb-3 p-2 border border-dark border-3 rounded shadow-sm   tbaro">

    <img src="<%= item.image %>" class="img-fluid w-100">

    <h3><%= item.title %></h3>

    <p><%= item.description %></p>

    <a href="<%= item.url %>"
       target="_blank"
       class="btn btn-primary">
      Read More
    </a>

  </div>

<% }) %>
    </div>

   <div class="col-2 max-auto" id="nmn" style="background-color: rgb(224, 252, 149);"></div>

  

  </div>
  </div>


</body>
</html>